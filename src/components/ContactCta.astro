---
import type { Lang } from '../i18n/ui'

interface Props {
  lang?: Lang
  id?: string
}
const { lang = 'cs', id = 'contact' } = Astro.props
---

<section class="cta-brutal" id={id}>
  <div class="container">
    <div class="cta-brutal__card">
      <svg class="cta-brutal__svg js-cta-svg" viewBox="0 0 1410 471" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <g class="cta-pill"><g class="cta-pill__inner"><g class="cta-pill__jelly"><rect width="220" height="400" rx="110" transform="matrix(0.847001 0.531591 -0.469059 0.883167 187.624 0)" fill="var(--clr-accent)"/></g></g></g>
        <g class="cta-pill"><g class="cta-pill__inner"><g class="cta-pill__jelly"><rect width="220" height="400" rx="110" transform="matrix(0.847001 0.531591 -0.469059 0.883167 394.817 0)" fill="var(--clr-accent)"/></g></g></g>
        <g class="cta-pill"><g class="cta-pill__inner"><g class="cta-pill__jelly"><rect width="220" height="400" rx="110" transform="matrix(0.847001 0.531591 -0.469059 0.883167 602.011 0)" fill="var(--clr-accent)"/></g></g></g>
        <g class="cta-pill"><g class="cta-pill__inner"><g class="cta-pill__jelly"><rect width="220" height="400" rx="110" transform="matrix(0.847001 0.531591 -0.469059 0.883167 809.205 0)" fill="var(--clr-accent)"/></g></g></g>
        <g class="cta-pill"><g class="cta-pill__inner"><g class="cta-pill__jelly"><rect width="220" height="400" rx="110" transform="matrix(0.847001 0.531591 -0.469059 0.883167 1016.4 0)" fill="var(--clr-accent)"/></g></g></g>
        <g class="cta-pill"><g class="cta-pill__inner"><g class="cta-pill__jelly"><rect width="220" height="400" rx="110" transform="matrix(0.847001 0.531591 -0.469059 0.883167 1223.59 0)" fill="var(--clr-accent)"/></g></g></g>
      </svg>
      <div class="cta-brutal__content">
        <p class="cta-brutal__text">
          {lang === 'cs' ? <>Máte projekt?<br />Pojďme se potkat.</> : <>Have a project?<br />Let’s meet.</>}
        </p>
        <button class="cta-brutal__btn" data-open-modal onclick="window.openModal?.()">
          {lang === 'cs' ? 'Ozvěte se' : 'Get in touch'}
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
            <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  const ctaSvg  = document.querySelector<SVGSVGElement>('.cta-brutal__svg')
  const ctaPills = ctaSvg?.querySelectorAll<SVGGElement>('.cta-pill')

  // Responsive shape count: 6 on desktop/tablet, 4 on mobile (crop the viewBox)
  if (ctaSvg) {
    const mq = window.matchMedia('(max-width: 40em)')
    const applyViewBox = () => {
      const mobile = mq.matches
      ctaSvg.setAttribute('viewBox', mobile ? '0 10 990 451' : '0 0 1410 471')
      ctaSvg.setAttribute('preserveAspectRatio', mobile ? 'xMidYMid slice' : 'xMidYMid meet')
    }
    applyViewBox()
    mq.addEventListener('change', applyViewBox)
  }

  const ctaInners = ctaSvg?.querySelectorAll<SVGGElement>('.cta-pill__inner')
  const ctaJellies = ctaSvg?.querySelectorAll<SVGGElement>('.cta-pill__jelly')
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (ctaSvg && ctaPills?.length && !reducedMotion) {
    // Pevné středy transformací spočítané jednou z netransformovaných tvarů.
    // (transformOrigin '50% 50%' se počítá z aktuálního — už transformovaného —
    // bboxu skupiny, takže pilulky po animaci zůstaly posunuté a uřízlé.)
    const boxes = Array.from(ctaPills, (p) => p.getBBox())
    const center = (i: number) => `${boxes[i].x + boxes[i].width / 2} ${boxes[i].y + boxes[i].height / 2}`
    const bottom = (i: number) => `${boxes[i].x + boxes[i].width / 2} ${boxes[i].y + boxes[i].height}`
    ctaPills.forEach((p, i) => gsap.set(p, { svgOrigin: center(i) }))
    ctaJellies?.forEach((j, i) => gsap.set(j, { svgOrigin: center(i) }))
    ctaInners?.forEach((n, i) => gsap.set(n, { svgOrigin: bottom(i) }))

    // 1) Pozice scrollu: každá pilulka zvlášť (stagger) z −10° do 0°.
    //    back.out = lehce přestřelí přes konečný stav a dosedne → bounce tažený scrollem.
    //    Od vjezdu do viewportu po střed obrazovky, při scrollu zpět se vrací.
    gsap.fromTo(ctaPills,
      { rotation: -10 },
      {
        rotation: 0,
        ease: 'back.out(2.2)',
        stagger: { each: 0.12, from: 'start' },
        scrollTrigger: { trigger: ctaSvg, start: 'top bottom', end: 'center center', scrub: 0.8, refreshPriority: -1 },
      }
    )

    // 2) Rychlost scrollu: pružina na každé pilulce. Rychlý scroll dolů je
    //    naklopí doprava, nahoru doleva; po zastavení se dokývou. Každá má
    //    jinou tuhost → vlna zleva doprava.
    if (ctaJellies?.length) {
      // Každá pilulka má vlastní quickTo s elastickým dokmitem; delší duration
      // u dalších pilulek = zpoždění → vlna zleva doprava.
      const tilts = Array.from(ctaJellies, (el, i) =>
        gsap.quickTo(el, 'rotation', { duration: 0.7 + i * 0.1, ease: 'elastic.out(1, 0.45)' })
      )
      const MAX_TILT = 14  // stupňů při rychlém švihu
      // Síla náklonu — skočí na rychlost scrollu a plynule spadne na 0, když scroll ustane
      const kick = { v: 0 }
      const apply = () => { for (const tilt of tilts) tilt(kick.v) }

      ScrollTrigger.create({
        trigger: ctaSvg,
        start: 'top bottom',
        end: 'bottom top',
        // přepočítat až po pinnutých sekcích výš na stránce (hero reel), jinak je start o délku pinu vedle
        refreshPriority: -1,
        onUpdate: (self) => {
          // px/s → stupně; scroll dolů = doprava, nahoru = doleva
          const v = gsap.utils.clamp(-MAX_TILT, MAX_TILT, self.getVelocity() / 110)
          if (Math.abs(v) > Math.abs(kick.v) || Math.sign(v) !== Math.sign(kick.v)) {
            kick.v = v
            gsap.to(kick, { v: 0, duration: 0.6, ease: 'power3.out', overwrite: true, onUpdate: apply })
            apply()
          }
        },
        onLeave: () => { kick.v = 0; apply() },
        onLeaveBack: () => { kick.v = 0; apply() },
      })
    }

    // Hover jede na vnitřním obalu, aby se nepral se scroll náklonem
    ctaSvg.addEventListener('mouseenter', () => {
      gsap.to(ctaInners!, { rotation: 10, duration: 0.4, stagger: { amount: 0.18, from: 'start' }, ease: 'power2.out', overwrite: 'auto' })
    })
    ctaSvg.addEventListener('mouseleave', () => {
      gsap.to(ctaInners!, { rotation: 0, duration: 0.5, stagger: { amount: 0.12, from: 'start' }, ease: 'power2.inOut', overwrite: 'auto' })
    })
  }
</script>

<style>
.cta-brutal { padding-block: var(--sp-3xl); }
.cta-brutal__card { position: relative; width: 100%; }
/* overflow: visible — při přestřelení/houpání nesmí viewBox uříznout okraje pilulek */
.cta-brutal__svg { display: block; width: 100%; height: auto; overflow: visible; }
.cta-brutal__content {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-xl);
  padding-inline: clamp(3.5rem, 10vw, 8rem);
}
.cta-brutal__text {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 3vw, 2.4rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: #fff;
  max-width: 16ch;
}
.cta-brutal__btn {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  white-space: nowrap;
  padding: 0.75em 1.5em;
  border-radius: 999px;
  background: var(--clr-text);
  color: var(--clr-bg);
  border: none;
  flex-shrink: 0;
  cursor: pointer;
  transition: gap 0.3s, background 0.25s, color 0.25s;
}
.cta-brutal__btn:hover { gap: 1rem; background: #fff; color: #111; }

@media (max-width: 40em) {
  .cta-pill:nth-child(n + 5) { display: none; }
  .cta-brutal .container { padding-inline: var(--sp-sm); }
  .cta-brutal__card { min-height: 18rem; }
  /* mobil: viewBox je oříznutý (slice) → přetékání by ukázalo odříznuté pilulky */
  .cta-brutal__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; }
  .cta-brutal__content {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--sp-md);
    padding-inline: var(--sp-md);
  }
  .cta-brutal__text { font-size: clamp(1.05rem, 5vw, 1.6rem); max-width: 16ch; }
}
</style>
