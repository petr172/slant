  will-change: transform;
}

/* Tmavý režim: sklo o něco hustší, ať je černý popisek kontrastní i nad tmavým pozadím */
:global(.dark) .hero__chip {
  border-color: rgba(255, 255, 255, 0.6);
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.66));
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 1),
    inset 0 0 14px rgba(255, 255, 255, 0.5),
    inset 0 -1px 2px rgba(0, 0, 0, 0.12),
    0 2px 6px rgba(0, 0, 0, 0.3),
    0 14px 32px -10px rgba(0, 0, 0, 0.6);
