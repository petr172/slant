/* Hover náhled kategorie (desktop) — stack karet 16:9, který se skládá na sebe */
.hero__chip-preview {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 0.7rem);            /* default: nad chipem */
  width: 220px;
