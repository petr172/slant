---
interface Logo {
  _key: string
  name: string
  logoUrl: string
  url?: string
}
interface Props {
  logos: Logo[]
  lang?: string
}
const { logos, lang = 'cs' } = Astro.props

const SLOTS = 6
const initial = logos.slice(0, SLOTS)
---

{logos?.length > 0 && (
  <section class="trust-wall">
    <p class="trust-wall__heading">
      {lang === 'cs' ? 'Děkujeme za důvěru' : 'Trusted by great brands'}
    </p>

    <ul class="trust-wall__list" id="js-trust-wall"
        data-logos={JSON.stringify(logos)}
        data-slots={SLOTS}>
      {initial.map((logo, i) => (
        <li class="trust-wall__item" data-index={i}>
          <div class="trust-wall__card">
            <div class="trust-wall__inner">
              {/* Plain <img>, not inline SVG: object-fit:contain scales the
                  logo to fit the box in every browser and can never crop it.
                  Inline SVG + WebKit was an endless source of clipping bugs. */}
              <img class="trust-wall__logo" src={logo.logoUrl} alt={logo.name}
                   loading="lazy" decoding="async" />
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

<script>
  const list = document.getElementById('js-trust-wall')
  if (list) {
    const logos: { name: string; logoUrl: string; url?: string }[] =
      JSON.parse(list.dataset.logos ?? '[]')
    const SLOTS = Number(list.dataset.slots ?? 6)

    if (logos.length > SLOTS) {
      let offset = 0

      const preload = (url: string) =>
        new Promise<void>((res) => {
          const img = new Image()
          img.onload = img.onerror = () => res()
          img.src = url
        })

      function swapAll() {
        offset = (offset + SLOTS) % logos.length
        const items = list!.querySelectorAll<HTMLElement>('.trust-wall__item')

        items.forEach((item, i) => {
          const inner = item.querySelector<HTMLElement>('.trust-wall__inner')
          const img = item.querySelector<HTMLImageElement>('.trust-wall__logo')
          if (!inner || !img) return

          const next = logos[(offset + i) % logos.length]

          setTimeout(async () => {
            // slide out up
            inner.style.transition = 'transform 0.35s cubic-bezier(0.4,0,1,1), opacity 0.3s ease'
            inner.style.transform  = 'translateY(-110%)'
            inner.style.opacity    = '0'

            await preload(next.logoUrl)

            setTimeout(() => {
              img.src = next.logoUrl
              img.alt = next.name

              // snap to bottom (hidden), then slide in
              inner.style.transition = 'none'
              inner.style.transform  = 'translateY(110%)'

              requestAnimationFrame(() => requestAnimationFrame(() => {
                inner.style.transition = 'transform 0.45s cubic-bezier(0.16,1,0.3,1), opacity 0.35s ease'
                inner.style.transform  = 'translateY(0)'
                inner.style.opacity    = '1'
              }))
            }, 370)
          }, i * 100)
        })
      }

      setInterval(swapAll, 5000)
    }
  }
</script>

<style>
.trust-wall {
  padding-block: var(--sp-xl);
  padding-inline: var(--gutter);
  width: 100%;
  max-width: 90rem;
  margin-inline: auto;
}

.trust-wall__heading {
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--clr-muted);
  margin-bottom: var(--sp-md);
}

.trust-wall__list {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: var(--sp-sm);
  list-style: none;
  margin: 0;
  padding: 0;
}

/* Tablet: 3 across (→ 3 + 3) */
@media (max-width: 64em) {
  .trust-wall__list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

/* Mobile: 2 across (→ 2 + 2 + 2) */
@media (max-width: 40em) {
  .trust-wall__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.trust-wall__card {
  background: var(--clr-surface);
  border-radius: var(--radius-md);
  overflow: hidden;
  aspect-ratio: 5 / 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trust-wall__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: var(--sp-sm);
  will-change: transform, opacity;
}

/* <img> is a replaced element: max-height + max-width with auto scale it to
   fit the box, preserving aspect ratio, in every browser — it cannot crop.
   grayscale + opacity give the muted monochrome look the inline-SVG
   currentColor trick used to provide. */
.trust-wall__logo {
  display: block;
  max-height: 64px;
  max-width: 82%;
  width: auto;
  height: auto;
  object-fit: contain;
  filter: grayscale(1);
  opacity: 0.5;
  transition: opacity 0.2s;
}

@media (max-width: 64em) {
  .trust-wall__logo { max-height: 52px; }
}
@media (max-width: 40em) {
  .trust-wall__logo { max-height: 44px; }
}
</style>
